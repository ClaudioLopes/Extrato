@page "/treino/sessao/{Id:int}"
@page "/treino/sessao/local/{IdCliente:guid}"
@implements IDisposable
@inject ApiClient Api
@inject RedeEstado Rede
@inject NavigationManager Nav

<PageTitle>extrato · sessão</PageTitle>

@if (_sessao == null)
{
    <p class="suave">@(_erro ?? "Carregando…")</p>
}
else
{
    <div class="topo">
        <div>
            <h1>Sessão @(_sessao.Rotina ?? "avulsa")</h1>
            <p class="subtitulo">@_sessao.DataHora.ToString("dd/MM/yyyy HH:mm") · séries pré-preenchidas com a última sessão</p>
        </div>
        <a class="btn" href="treino">Encerrar</a>
    </div>

    @if (_sessao.Id == 0)
    {
        <div class="aviso">Sessão iniciada sem internet: fica salva no aparelho e é enviada, com as séries, quando a conexão voltar.</div>
    }
    @if (_erro != null) { <div class="erro">@_erro</div> }

    @foreach (var ex in _sessao.Exercicios)
    {
        var entrada = Entrada(ex);
        <section class="cartao">
            <div class="linha entre">
                <div>
                    <h3 style="margin:0"><a href="@($"treino/aparelho/{ex.Aparelho.Id}")">@ex.Aparelho.Nome</a></h3>
                    <div class="suave pequeno">@ex.Aparelho.Exercicio
                        @if (ex.SeriesAlvo is { } sa) { <span>· alvo @sa×@ex.RepsMin–@ex.RepsMax</span> }
                    </div>
                </div>
                <Comparacao Hoje="ex.Melhor1RmHoje" Antes="ex.Melhor1RmAnterior" VolumeHoje="ex.VolumeHoje" VolumeAntes="ex.VolumeAnterior" />
            </div>

            @if (ex.UltimaSessao.Count > 0)
            {
                <div class="suave pequeno" style="margin:6px 0">Última: @string.Join(" · ", ex.UltimaSessao.Select(s => $"{s.CargaKg:0.#}kg×{s.Reps}"))</div>
            }

            @foreach (var s in ex.SeriesHoje)
            {
                <div class="linha" style="padding:4px 0">
                    <span class="etiqueta">@s.Ordem</span>
                    <span class="numero forte">@s.CargaKg.ToString("0.#") kg × @s.Reps</span>
                    @if (s.RepsNaReserva is { } rir) { <span class="suave pequeno">RIR @rir</span> }
                    @if (s.Pendente) { <span class="suave pequeno" title="Salva no aparelho, aguardando conexão">⏳ pendente</span> }
                    <button class="btn mini perigo" @onclick="() => RemoverSerie(s)">✕</button>
                </div>
            }

            <div class="linha" style="margin-top:8px">
                <input type="number" step="0.5" style="max-width:100px" @bind="entrada.CargaKg" aria-label="carga" /> kg ×
                <input type="number" style="max-width:70px" @bind="entrada.Reps" aria-label="repetições" /> reps
                <button class="btn primario" disabled="@_ocupado" @onclick="() => Registrar(ex.Aparelho.Id, entrada)">＋ Série</button>
            </div>
        </section>
    }

    <section class="cartao">
        <h3>Adicionar aparelho avulso</h3>
        <div class="linha">
            <select @bind="_avulso" class="cresce" style="width:auto">
                <option value="0">Escolha…</option>
                @foreach (var a in _aparelhos.Where(a => _sessao.Exercicios.All(e => e.Aparelho.Id != a.Id))) { <option value="@a.Id">@a.Nome</option> }
            </select>
            <button class="btn" disabled="@(_avulso == 0)" @onclick="AdicionarAvulso">Adicionar</button>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    /// <summary>Sessão iniciada offline: id gerado no aparelho até a fila ser enviada.</summary>
    [Parameter] public Guid? IdCliente { get; set; }

    private SessaoDto? _sessao;
    private List<AparelhoDto> _aparelhos = [];
    private readonly Dictionary<int, NovaSerieDto> _entradas = [];
    private readonly List<AparelhoDto> _avulsos = [];
    private int _avulso;
    private string? _erro;
    private bool _ocupado;

    protected override void OnInitialized() => Rede.Sincronizou += AoSincronizar;

    /// <summary>Ao trocar de rota (local → servidor), o parâmetro que não vem na nova rota não pode ficar com o valor antigo.</summary>
    public override Task SetParametersAsync(ParameterView parameters)
    {
        Id = 0;
        IdCliente = null;
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnParametersSetAsync()
    {
        _sessao = null; _erro = null;
        _entradas.Clear(); _avulsos.Clear();
        try
        {
            _aparelhos = await Api.AparelhosAsync();
            await Carregar();
        }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task Carregar()
    {
        if (IdCliente is { } idCliente)
        {
            var s = await Api.SessaoLocalAsync(idCliente);
            if (s.Id > 0) // a fila já enviou: segue na sessão do servidor
            {
                Nav.NavigateTo($"treino/sessao/{s.Id}", replace: true);
                return;
            }
            _sessao = s;
        }
        else _sessao = await Api.SessaoAsync(Id);

        // aparelhos avulsos escolhidos e ainda sem série continuam na tela
        var faltando = _avulsos.Where(a => _sessao.Exercicios.All(e => e.Aparelho.Id != a.Id))
            .Select(a => new ExercicioSessaoDto(a, null, null, null, [], [], null, null, 0, 0));
        _sessao = _sessao with { Exercicios = _sessao.Exercicios.Concat(faltando).ToList() };
    }

    private void AoSincronizar() => _ = InvokeAsync(async () =>
    {
        try { await Carregar(); } catch (Exception ex) { _erro = ex.Message; }
        StateHasChanged();
    });

    /// <summary>Pré-preenche com a série seguinte da última sessão (ou a última feita hoje).</summary>
    private NovaSerieDto Entrada(ExercicioSessaoDto ex)
    {
        if (_entradas.TryGetValue(ex.Aparelho.Id, out var e)) return e;
        var referencia = ex.SeriesHoje.LastOrDefault()
            ?? ex.UltimaSessao.ElementAtOrDefault(ex.SeriesHoje.Count)
            ?? ex.UltimaSessao.LastOrDefault();
        e = new NovaSerieDto { AparelhoId = ex.Aparelho.Id, CargaKg = referencia?.CargaKg ?? 0, Reps = referencia?.Reps ?? ex.RepsMax ?? 10 };
        _entradas[ex.Aparelho.Id] = e;
        return e;
    }

    private async Task Registrar(int aparelhoId, NovaSerieDto entrada)
    {
        _ocupado = true; _erro = null;
        try
        {
            await Api.RegistrarSerieAsync(Id, IdCliente, entrada);
            _entradas.Remove(aparelhoId);
            await Carregar();
            // próxima série parte da que acabou de ser feita
            _entradas[aparelhoId] = new NovaSerieDto { AparelhoId = aparelhoId, CargaKg = entrada.CargaKg, Reps = entrada.Reps };
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _ocupado = false; }
    }

    private async Task RemoverSerie(SerieDto serie)
    {
        _erro = null;
        try { await Api.RemoverSerieAsync(Id, serie); await Carregar(); }
        catch (SemConexaoException) { _erro = "Sem conexão: só dá para remover séries que ainda não foram enviadas."; }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private void AdicionarAvulso()
    {
        var a = _aparelhos.First(x => x.Id == _avulso);
        _avulso = 0;
        _avulsos.Add(a);
        _sessao = _sessao! with
        {
            Exercicios = _sessao.Exercicios.Append(new ExercicioSessaoDto(a, null, null, null, [], [], null, null, 0, 0)).ToList()
        };
    }

    public void Dispose() => Rede.Sincronizou -= AoSincronizar;
}
