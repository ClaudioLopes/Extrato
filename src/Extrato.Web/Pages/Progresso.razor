@page "/progresso"
@inject ApiClient Api

<PageTitle>extrato · progresso</PageTitle>

<div class="topo">
    <div>
        <h1>Progresso</h1>
        <p class="subtitulo">A meta só muda pela tendência semanal (média móvel de 7 dias).</p>
    </div>
    <button class="btn" disabled="@_ocupado" @onclick="RodarAjuste">Rodar ajuste semanal</button>
</div>

@if (_erro != null) { <div class="erro">@_erro</div> }
@if (_ajuste != null)
{
    <div class="@(_ajuste.Ajustou ? "ok" : "aviso")">
        <strong>@(_ajuste.Ajustou ? $"Meta ajustada: {_ajuste.KcalAnterior} → {_ajuste.KcalNova} kcal" : "Sem ajuste")</strong><br />@_ajuste.Motivo
    </div>
}

<div class="grade">
    <section class="cartao">
        <h2>Peso</h2>
        <div class="linha">
            <input type="date" @bind="_dataPeso" style="max-width:160px" />
            <input type="number" step="0.1" min="30" max="300" placeholder="kg" @bind="_peso" style="max-width:110px" />
            <button class="btn primario" disabled="@(_peso is null || _ocupado)" @onclick="SalvarPeso">Registrar</button>
        </div>
        @if (_progresso is { Peso.Count: > 0 })
        {
            <GraficoPeso Pontos="_progresso.Peso" />
            <p class="suave pequeno"><span class="ponto c-prot"></span>peso do dia <span class="ponto c-kcal" style="margin-left:10px"></span>média móvel 7 dias</p>
        }
    </section>

    <section class="cartao">
        <h2>Medidas semanais</h2>
        <div class="grade-2">
            <div class="campo"><label>Cintura (cm)</label><input type="number" step="0.5" @bind="_medidas.CinturaCm" /></div>
            <div class="campo"><label>Pescoço (cm)</label><input type="number" step="0.5" @bind="_medidas.PescocoCm" /></div>
            <div class="campo"><label>Quadril (cm, obrigatório p/ mulher)</label><input type="number" step="0.5" @bind="_medidas.QuadrilCm" /></div>
            <div class="campo"><label>Data</label><input type="date" @bind="_dataMedidas" /></div>
        </div>
        <div class="campo"><label>Observação corporal (texto, nunca foto)</label><input @bind="_medidas.ObservacaoCorporal" /></div>
        <button class="btn primario" disabled="@_ocupado" @onclick="SalvarMedidas">Registrar medidas</button>

        @if (_progresso is { Medidas.Count: > 0 })
        {
            <table style="margin-top:12px">
                <thead><tr><th>Data</th><th>Cintura</th><th>Pescoço</th><th>% gordura*</th></tr></thead>
                <tbody>
                    @foreach (var m in _progresso.Medidas.OrderByDescending(m => m.Data))
                    {
                        <tr><td>@m.Data.ToString("dd/MM")</td><td class="numero">@m.CinturaCm</td><td class="numero">@m.PescocoCm</td><td class="numero">@(m.GorduraEstimadaPercent?.ToString("0.0") ?? "—")</td></tr>
                    }
                </tbody>
            </table>
            <p class="suave pequeno">* Método da Marinha americana, só para acompanhar tendência.</p>
        }
    </section>
</div>

@if (_progresso != null)
{
    <section class="cartao">
        <h2>Histórico de ajustes da meta</h2>
        @if (_progresso.Ajustes.Count == 0) { <p class="suave">Nenhum ajuste ainda. Precisa de ≥5 dias registrados na semana e 2 semanas fora da faixa.</p> }
        @foreach (var a in _progresso.Ajustes)
        {
            <div class="lancamento">
                <div class="cresce"><strong>@a.Data.ToString("dd/MM/yyyy")</strong> <span class="numero">@a.KcalAnterior → @a.KcalNova kcal</span><div class="suave pequeno">@a.Motivo</div></div>
            </div>
        }
        @if (_progresso.ErroMedioIAGramas is { } erro)
        {
            <p class="suave pequeno">Erro médio da IA nas porções confirmadas: <strong>@erro.ToString("0.#") g</strong> por item.</p>
        }
    </section>
}

@code {
    private ProgressoDto? _progresso;
    private AjusteSemanalDto? _ajuste;
    private string? _erro;
    private bool _ocupado;
    private decimal? _peso;
    private DateOnly _dataPeso = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly _dataMedidas = DateOnly.FromDateTime(DateTime.Now);
    private NovasMedidasDto _medidas = new();

    protected override Task OnInitializedAsync() => Carregar();

    private async Task Carregar()
    {
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Now);
            _progresso = await Api.ProgressoAsync(hoje.AddDays(-60), hoje);
        }
        catch (Exception ex) { _erro = ex.Message; }
    }

    private async Task Executar(Func<Task> acao)
    {
        _ocupado = true; _erro = null;
        try { await acao(); await Carregar(); }
        catch (Exception ex) { _erro = ex.Message; }
        finally { _ocupado = false; }
    }

    private Task SalvarPeso() => Executar(async () => { await Api.RegistrarPesoAsync(new NovoPesoDto { Data = _dataPeso, PesoKg = _peso!.Value }); _peso = null; });

    private Task SalvarMedidas() => Executar(async () =>
    {
        _medidas.Data = _dataMedidas;
        await Api.RegistrarMedidasAsync(_medidas);
        _medidas = new();
    });

    private Task RodarAjuste() => Executar(async () => _ajuste = await Api.AjusteSemanalAsync());
}
